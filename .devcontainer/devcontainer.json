{
  "name": "hellocode (finance tracker)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "remoteUser": "vscode",
  "postCreateCommand": "python -m pip install -r requirements.txt pyflakes && curl -fsSL https://opencode.ai/v2/install | bash",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": false,
        "files.trimTrailingWhitespace": true
      }
    }
  }
}